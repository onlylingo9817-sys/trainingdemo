    curve: smooth
    arrow: [null, stealth]
    border: {style: solid, width: 2.5, color: "$primary"}
  - elementId: a4
    elementType: line
    bounds: [295, 395, 80, 150]
    viewBox: [80, 150]
    points: "0,150 0,80 80,5"
    curve: smooth
    arrow: [null, stealth]
    border: {style: solid, width: 2.5, color: "$primary"}
  - elementId: a5
    elementType: line
    bounds: [375, 190, 160, 110]
    viewBox: [160, 110]
    points: "0,110 50,15 160,5"
    curve: smooth
    arrow: [null, stealth]
    border: {style: solid, width: 2.5, color: "$primary"}
  - elementId: a5-label
    elementType: text
    bounds: [396, 214, 120, 18]
    content:
      fontSize: 11
      color: "#B05A2A"
      wrap: false
      text: 诊断 · 调优 · 回滚

  # ---------- 中心枢纽 ----------
  - elementId: halo
    elementType: shape
    bounds: [508, 288, 264, 264]
    shapeName: ellipse
    fill: {type: solid, color: "$halo"}
  - elementId: hub
    elementType: shape
    bounds: [532, 312, 216, 216]
    shapeName: ellipse
    fill:
      type: gradient
      gradientType: linear
      angle: 135
      stops:
        - {position: 0, color: "#F07A2E"}
        - {position: 1, color: "$primaryDeep"}
    shadow: {blur: 18, color: "#E85D2440", offset: [0, 6]}
  - elementId: hub-icon
    elementType: icon
    bounds: [614, 342, 52, 52]
    iconName: "fas:bullseye"
    fill: {type: solid, color: "#FFFFFF"}
  - elementId: hub-name
    elementType: text
    bounds: [532, 402, 216, 38]
    content:
      fontSize: 26
      bold: true
      color: "#FFFFFF"
      align: [center, middle]
      wrap: false
      text: 知识点
  - elementId: hub-sub
    elementType: text
    bounds: [540, 444, 200, 36]
    content:
      fontSize: 11
      color: "#FFE3CF"
      align: [center, top]
      lineHeight: 1.4
      text: |
        <p>探需提问 · 价格异议处理</p>
        <p>6.6kW 外放电</p>

