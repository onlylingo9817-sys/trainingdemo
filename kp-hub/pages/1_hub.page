pageType: content
background:
  type: solid
  color: "$paper"
elements:
  # ---------- 标题区 ----------
  - elementId: title
    elementType: text
    bounds: [64, 38, 720, 42]
    content:
      fontSize: 32
      bold: true
      color: "$ink"
      wrap: false
      text: 知识点：培训全链路的枢纽
  - elementId: subtitle
    elementType: text
    bounds: [64, 88, 820, 22]
    content:
      fontSize: 14
      color: "$sub"
      wrap: false
      text: 一名顾问「要会讲、要会做」的最小单元 —— 只有两类：产品知识（会讲）/ 销售动作（会做）
  - elementId: badge
    elementType: shape
    bounds: [1052, 44, 164, 30]
    shapeName: roundRect
    adjustments: [50000]
    fill: {type: solid, color: "#FBEADB"}
  - elementId: badge-t
    elementType: text
    bounds: [1052, 44, 164, 28]
    content:
      fontSize: 12
      color: "$primary"
      align: [center, middle]
      wrap: false
      text: 培训全链路闭环 · 示意图

  # ---------- 中心辐射线（压在节点和枢纽下面） ----------
  - elementId: sp1
    elementType: line
    bounds: [639, 250, 2, 62]
    viewBox: [2, 62]
    points: "1,62 1,0"
    border: {style: solid, width: 1.5, color: "$spoke"}
  - elementId: sp2
    elementType: line
    bounds: [700, 346, 140, 20]
    viewBox: [140, 20]
    points: "0,19 140,1"
    border: {style: solid, width: 1.5, color: "$spoke"}
  - elementId: sp3
    elementType: line
    bounds: [705, 480, 65, 68]
    viewBox: [65, 68]
    points: "0,0 65,68"
    border: {style: solid, width: 1.5, color: "$spoke"}
  - elementId: sp4
    elementType: line
    bounds: [510, 480, 65, 68]
    viewBox: [65, 68]
    points: "65,0 0,68"
    border: {style: solid, width: 1.5, color: "$spoke"}
  - elementId: sp5
    elementType: line
    bounds: [440, 346, 140, 20]
    viewBox: [140, 20]
    points: "140,19 0,1"
    border: {style: solid, width: 1.5, color: "$spoke"}

  # ---------- 环形箭头（顺时针闭环） ----------
  - elementId: a1
    elementType: line
    bounds: [745, 190, 160, 110]
    viewBox: [160, 110]
    points: "0,5 110,15 160,110"
    curve: smooth
    arrow: [null, stealth]
    border: {style: solid, width: 2.5, color: "$primary"}
  - elementId: a2
    elementType: line
    bounds: [900, 395, 85, 150]
